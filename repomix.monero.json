{
  "output": {
    "filePath": "context-monero.xml",
    "style": "xml",
    "showLineNumbers": true
  },
  "ignore": {
    "customPatterns": [
      "target/**",
      "*.lock",
      ".git/**",
      "context*.xml",
      "monero-swap-context-*.txt",
      "node_modules/**",
      "__pycache__/**",
      "*.pyc",
      ".cursor/**",
      "terminals/**",
      "cairo/**",
      "docs/archive/**",
      "watchtower/target/**"
    ]
  },
  "include": [
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "OVERNIGHT_TEST_RESULTS.md",
    ".cursorrules",
    "deny.toml",
    "docs/ARCHITECTURE.md",
    "docs/PROTOCOL.md",
    "docs/SETUP.md",
    "docs/AUDIT_DEPENDENCIES.md",
    "docs/decisions/001-key-splitting.md",
    "rust/Cargo.toml",
    "rust/src/lib.rs",
    "rust/src/main.rs",
    "rust/src/dleq.rs",
    "rust/src/monero/**",
    "rust/src/monero/finality.rs",
    "rust/src/monero/transaction.rs",
    "rust/src/monero/decoy_selection.rs",
    "rust/src/monero/address.rs",
    "rust/src/monero_wallet/client.rs",
    "rust/src/swap/**",
    "rust/src/swap/state.rs",
    "rust/src/swap/db.rs",
    "rust/src/swap/driver.rs",
    "rust/src/swap/starknet_manual.rs",
    "rust/src/adaptor/**",
    "rust/src/starknet.rs",
    "rust/src/starknet_full.rs",
    "rust/src/monero_full.rs",
    "rust/src/poseidon.rs",
    "rust/src/monero_wallet/**",
    "rust/tests/**",
    "rust/tests/finality_test.rs",
    "rust/tests/monero_integration_test.rs",
    "rust/tests/swap_state_test.rs",
    "rust/tests/swap_driver_test.rs",
    "rust/tests/swap_security_test.rs",
    "rust/tests/devnet_e2e_test.rs",
    "rust/tests/edge_cases_test.rs",
    "rust/tests/handle_secret_revealed_test.rs",
    "rust/tests/get_current_monero_height_test.rs",
    "rust/tests/wallet_rpc_manual_test.rs",
    "rust/tests/crypto_properties_test.rs",
    "rust/tests/e2e_full_swap_test.rs",
    "rust/tests/helpers/monero_wallet.rs",
    "rust/tests/wallet_integration_test.rs",
    "rust/test_vectors.json",
    "rust/src/bin/maker.rs",
    "rust/src/bin/taker.rs",
    "rust/src/bin/generate_test_vector.rs",
    "tools/verify_full_compatibility.py",
    "tools/verify_rust_cairo_equivalence.py",
    "scripts/devnet.sh",
    "scripts/start-devnet.sh",
    "docker-compose.yml",
    ".github/workflows/security.yml",
    "Dockerfile.wallet-rpc",
    "Makefile",
    "watchtower/Cargo.toml",
    "watchtower/README.md",
    "watchtower/src/**"
  ]
}
