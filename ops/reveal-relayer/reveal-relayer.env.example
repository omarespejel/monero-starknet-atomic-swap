# Copy to /etc/atomic-swap/reveal-relayer/<swap-id>.env on the Monero VM.
# This file should not contain the reveal secret itself. Store the secret in
# REVEAL_SECRET_FILE with mode 0600 and ownership readable only by atomic-swap.

RUST_LOG=info,xmr_secret_gen=info

STARKNET_NETWORK=sepolia
STARKNET_RPC_URL=https://api.zan.top/public/starknet-sepolia/rpc/v0_10
SNCAST_ACCOUNT=stealth-deployer-2026-01-21
SNCAST_ACCOUNTS_FILE=/home/atomic-swap/.starknet_accounts/starknet_open_zeppelin_accounts.json
# Required only for mainnet reveal. The release file must be public and
# secret-free, and it must bind starknet_network=mainnet plus the AtomicLock
# contract address. Leave unset for Sepolia.
ATOMIC_SWAP_MAINNET_RELEASE_FILE=
ATOMIC_SWAP_ALLOW_MAINNET=

ATOMIC_SWAP_CONTRACT_ADDRESS=0x...
ATOMIC_SWAP_TOKEN_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d

MONERO_WALLET_RPC_URL=http://127.0.0.1:38090/json_rpc
# Optional. If unset, the relayer scans inbound transfers in this per-swap
# wallet and reveals after one reaches EXPECTED_MONERO_AMOUNT_PICONERO.
MONERO_TXID=
EXPECTED_MONERO_AMOUNT_PICONERO=5000000000
MONERO_CONFIRMATIONS=10
MONERO_POLL_INTERVAL_SECS=20
MONERO_REVEAL_TIMEOUT_SECS=7200

REVEAL_SECRET_FILE=/etc/atomic-swap/reveal-relayer/secrets/<swap-id>.secret
ATOMIC_LOCK_OPS_SCRIPT=/opt/monero-starknet-atomic-swap/scripts/atomic_lock_sncast_ops.sh
REVEAL_RELAYER_BIN=/opt/monero-starknet-atomic-swap/rust/target/release/relay_reveal

# Set to 1 for rehearsal. Live operation leaves this at 0.
REVEAL_DRY_RUN=0

# Set to 1 when the same relayer account should claim the Starknet escrow after
# the contract grace period expires.
REVEAL_CLAIM_AFTER_REVEAL=0
REVEAL_CLAIM_GRACE_SECS=7200
REVEAL_CLAIM_RETRY_INTERVAL_SECS=30
REVEAL_CLAIM_TIMEOUT_SECS=1800
