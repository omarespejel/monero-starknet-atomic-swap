# Copy to /etc/atomic-swap/claim-relayer.env on the Monero VM.
# chmod 600 this file if it also contains secrets. Prefer keeping partial keys
# in /etc/atomic-swap/claim-relayer.secrets instead.

RUST_LOG=info,xmr_secret_gen=info
MONERO_WALLET_RPC_TIMEOUT_SECS=300
MONERO_WALLET_RPC_CONNECT_TIMEOUT_SECS=10
