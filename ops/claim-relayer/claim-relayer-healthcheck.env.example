# Copy to /etc/atomic-swap/claim-relayer-healthcheck.env on the Monero VM.

RELAYER_CONFIG=/etc/atomic-swap/claim-relayer.config.json
RELAYER_CURSOR_DIR=/var/lib/atomic-swap/claim-relayer/cursors
RELAYER_SERVICE=monero-claim-relayer.service
WALLET_RPC_SERVICE=monero-claim-wallet-rpc.service
WALLET_RPC_URL=http://127.0.0.1:38091/json_rpc

# Production long-running mode should leave this at 1. Set to 0 for one-shot
# rehearsals where monero-claim-relayer.service exits successfully after a pass.
RELAYER_EXPECT_ACTIVE=1
WALLET_RPC_EXPECT_ACTIVE=1

# Cursors should move when the relayer is processing finalized block ranges.
RELAYER_MAX_CURSOR_AGE_SECS=600

# Recent journald window scanned for relayer/registry failure patterns.
RELAYER_JOURNAL_SINCE="15 minutes ago"

# Optional. If set, monero-claim-relayer-alert@.service posts healthcheck
# failures to this webhook. Keep the real value in this root-owned env file.
RELAYER_ALERT_WEBHOOK_URL=
# Optional rehearsal sink. If set, alert JSON is appended to this root-owned
# file even when no webhook is configured.
RELAYER_ALERT_FILE=
RELAYER_ALERT_ENVIRONMENT=stagenet
