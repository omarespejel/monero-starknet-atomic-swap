# Copy to /etc/atomic-swap/monero-wallet-rpc/mainnet.env on the Monero VM.

MONERO_NETWORK=mainnet
MONERO_WALLET_DIR=/home/atomic-swap/monero-mainnet-wallets
MONERO_DAEMON_ADDRESS=node2.monerodevs.org:18089
MONERO_WALLET_RPC_PORT=18091
MONERO_WALLET_RPC_LOG=/var/log/atomic-swap/mainnet-wallet-rpc.log
MONERO_WALLET_RPC_TRUSTED_DAEMON=1
