[Unit]
Description=Alert for Starknet-to-Monero claim relayer failure in %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/atomic-swap/claim-relayer-healthcheck.env
ExecStart=/opt/monero-starknet-atomic-swap/ops/claim-relayer/claim-relayer-alert.sh %i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/etc/atomic-swap /var/lib/atomic-swap /var/log/atomic-swap
