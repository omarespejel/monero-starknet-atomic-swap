# Copy to /etc/atomic-swap/monero-wallet-rpc/stagenet.env on the Monero VM.

MONERO_NETWORK=stagenet
MONERO_WALLET_DIR=/home/atomic-swap/monero-wallets
MONERO_DAEMON_ADDRESS=node2.monerodevs.org:38089
MONERO_WALLET_RPC_PORT=38091
MONERO_WALLET_RPC_LOG=/var/log/atomic-swap/stagenet-wallet-rpc.log
MONERO_WALLET_RPC_TRUSTED_DAEMON=1
