[Unit]
Description=Monero-to-Starknet atomic-swap reveal relayer for %i
After=network-online.target monero-claim-wallet-rpc.service
Wants=network-online.target monero-claim-wallet-rpc.service
OnFailure=monero-reveal-relayer-alert@%n.service

[Service]
Type=oneshot
User=atomic-swap
Group=atomic-swap
WorkingDirectory=/opt/monero-starknet-atomic-swap
Environment=HOME=/home/atomic-swap
Environment=PATH=/home/atomic-swap/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/atomic-swap/reveal-relayer/%i.env
ExecStart=/opt/monero-starknet-atomic-swap/ops/reveal-relayer/run-reveal-relayer.sh
TimeoutStartSec=infinity
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/etc/atomic-swap /opt/monero-starknet-atomic-swap
ReadWritePaths=/var/lib/atomic-swap /var/log/atomic-swap /home/atomic-swap/.starknet_accounts /home/atomic-swap/.snfoundry

[Install]
WantedBy=multi-user.target
